{
  "name": "docxsafe-editor",
  "version": "1.0.0",
  "description": "DocXSafe Editor - browser-based WYSIWYG DOCX editor with comments, suggestions, Word tags, viewer mode and print to PDF",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./core-plugins": {
      "types": "./dist/core-plugins.d.ts",
      "import": "./dist/core-plugins.js",
      "require": "./dist/core-plugins.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "import": "./dist/collaboration.js",
      "require": "./dist/collaboration.cjs"
    },
    "./collaboration/styles.css": "./dist/collaboration.css",
    "./collaborative-docs": {
      "types": "./dist/collaborative-docs.d.ts",
      "import": "./dist/collaborative-docs.js",
      "require": "./dist/collaborative-docs.cjs"
    },
    "./collaborative-docs/server": {
      "types": "./dist/collaborative-docs-server.d.ts",
      "import": "./dist/collaborative-docs-server.js",
      "require": "./dist/collaborative-docs-server.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "docxsafe-editor-mcp": "./dist/mcp-cli.js",
    "docxsafe-collab-server": "./dist/collab-server-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "collaboration:server": "tsx src/collaborative-docs/server/cli.ts",
    "dev:collab": "npm run collaboration:server & vite",
    "build": "tsup && bun run build:css",
    "build:css": "tailwindcss -c ./tailwind.config.lib.js -i ./src/styles/editor.css -o ./dist/styles.css --minify && cp src/collaboration/collaboration.css dist/collaboration.css",
    "build:demo": "vite build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:visual": "npx playwright test visual.spec.ts",
    "test:screenshots": "npx playwright test --project=chromium --reporter=list",
    "prepublishOnly": "bun test && NODE_ENV=production bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "docxtemplater": "^3.50.0",
    "jszip": "^3.10.1",
    "pizzip": "^3.1.7",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-history": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.19.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.32.7",
    "ws": "^8.22.0",
    "xml-js": "^1.6.11",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^13.3.8",
    "@playwright/test": "^1.58.1",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/simple-peer": "^9.11.9",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.33",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "docx",
    "editor",
    "template",
    "word",
    "document",
    "react",
    "prosemirror",
    "collaboration",
    "yjs",
    "webrtc"
  ],
  "author": "DocXSafe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docxsafe/docxsafe-editor.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
